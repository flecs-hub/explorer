{
    "id": "flecs.explorer",
    "type": "application",
    "value": {
        "use": [
            "box"
        ]
    },
    "lang.c": {
        "${os linux}": {
            "lib": [
                "rt",
                "pthread",
                "m"
            ]
        },
        "${target em}": {
            "ldflags": [
                "-sSTACK_SIZE=8388608",
                "-Wl,-u,ntohs"
            ],
            "embed": [
                ".box/etc@etc"
            ]
        }
    }
}
